NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/wisepace
CORS_ORIGINS=http://localhost:4200
# Set only when deployed behind a known reverse proxy; number of trusted proxy hops.
TRUST_PROXY=0
# AUTH_MODE=directus validates bearer tokens against DIRECTUS_URL/users/me.\n# Use AUTH_MODE=standalone only when an issuer you control signs the JWTs below.\nAUTH_MODE=standalone\nAUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=wisepace-auth
AUTH_JWT_AUDIENCE=wisepace-api
WELLAR_OWNER_ROLE_ID=
WELLAR_HR_ROLE_ID=
WELLAR_MANAGER_ROLE_ID=
WELLAR_EMPLOYEE_ROLE_ID=

# Directus mail delivery for account deletion requests
DIRECTUS_URL=
DIRECTUS_STATIC_TOKEN=
ACCOUNT_DELETION_RECIPIENT_EMAIL=
